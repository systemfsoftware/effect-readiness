{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "XDG_CACHE_HOME",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "build": {
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "bin/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "package.json",
        "tsdown.config.*",
        "api-extractor.json",
        "etc/*.api.md"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "build"
      ],
      "cache": true
    },
    "//#typecheck:node": {
      "outputLogs": "errors-only",
      "inputs": [
        "tsconfig.node.json",
        "commitlint.config.ts",
        "oxlint.shared.ts"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "vitest.config.*",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md",
        "!**/etc/*.api.md"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [
        "coverage/**",
        "reports/**"
      ],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT",
        "COVERAGE",
        "CONFORMANCE_PROFILE"
      ],
      "cache": true
    },
    "mutation": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT"
      ],
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.shared.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "build"
      ],
      "env": [
        "NODE_ENV",
        "GITHUB_ACTIONS",
        "OXLINT_FORMAT",
        "AGENT"
      ],
      "cache": true
    },
    "api:check": {
      "outputLogs": "errors-only",
      "inputs": [
        "src/**",
        "api-extractor.json",
        "tsconfig.build.json",
        "tsconfig.*.json",
        "etc/*.api.md"
      ],
      "outputs": [
        "dist/*.d.ts",
        "etc/*.api.md",
        "temp/**"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "attw": {
      "outputLogs": "errors-only",
      "inputs": [
        "dist/**",
        "package.json"
      ],
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
